NODE_ENV=development
APP_ENV=development
PORT=4000
LOG_LEVEL=info

APP_WEB_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

DATABASE_URL="mysql://root:YOUR_MYSQL_PASSWORD@localhost:3306/career_lab"

ACCESS_TOKEN_TTL_MINUTES=15
SESSION_TTL_DAYS=30
SESSION_ABSOLUTE_TTL_DAYS=180
COOKIE_SECURE=false

ARGON2_MEMORY_KIB=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1

JWT_PRIVATE_KEY_PATH=keys/jwt-private.pem
JWT_PUBLIC_KEYS_DIR=keys

# Deployed/serverless only: base64-encoded PEMs, because key files are
# gitignored. These take precedence over the path variables above.
# Generate (PowerShell):
#   [Convert]::ToBase64String([IO.File]::ReadAllBytes("keys/jwt-private.pem"))
#   [Convert]::ToBase64String([IO.File]::ReadAllBytes("keys/jwt-public.pem"))
# JWT_PRIVATE_KEY_BASE64=
# JWT_PUBLIC_KEYS_BASE64=

# SMTP — leave SMTP_HOST empty to log emails to the console instead of sending.
# Gmail example: create an App Password at https://myaccount.google.com/apppasswords
# (requires 2-Step Verification), then set:
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=465
#   SMTP_SECURE=true
#   SMTP_USER=you@gmail.com
#   SMTP_PASS=<16-char app password>
# MAIL_FROM must be the same address as SMTP_USER or Gmail may reject delivery.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Career Lab <no-reply@localhost>"

# ---------------------------------------------------------------------------
# Supabase sync (backend-only; never expose these values to the frontend)
# ---------------------------------------------------------------------------
# Use the service-role or secret key for server-side writes; the anon key is
# only a fallback and will fail once Row Level Security is enabled.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_SECRET_KEY=            # alternative to SUPABASE_SERVICE_ROLE_KEY
# SUPABASE_ANON_KEY=              # fallback for read-only/RLS-permitted scans
SUPABASE_SCHEMA=public
# Supabase is a mirror: keep calls short and retry transient network drops.
SUPABASE_TIMEOUT_MS=5000
SUPABASE_MAX_RETRIES=2

# ---------------------------------------------------------------------------
# AI code + interview review (server-side only)
# ---------------------------------------------------------------------------
# Any OpenAI-compatible chat-completions endpoint works. Leave the key empty
# to use the deterministic fallback reviewer instead of a live model. Interview
# answer reviews use the same provider and model.
AI_GRADING_API_URL=https://api.openai.com/v1/chat/completions
AI_GRADING_API_KEY=
AI_GRADING_MODEL=gpt-4o-mini
AI_GRADING_TIMEOUT_MS=25000

# Optional direct Postgres connection, used only to advance bigint identity
# sequences after explicit IDs are upserted. Use the non-pooling URL (port 5432).
SUPABASE_DB_URL=
SUPABASE_DB_SSL=true
# Supabase's pooler presents a self-signed chain; set to false only for that host.
SUPABASE_DB_SSL_REJECT_UNAUTHORIZED=true

# Optional migration defaults (CLI flags override these).
# MIGRATION_BATCH_SIZE=500
# MIGRATION_MAX_BYTES=4000000
# MIGRATION_MAX_RETRIES=4
# MIGRATION_TABLES=
# MIGRATION_EXCLUDE_TABLES=_prisma_migrations
# MIGRATION_SINCE=
# MIGRATION_VERIFY=false
# MIGRATION_DRY_RUN=false
# MIGRATION_DEBUG=false
